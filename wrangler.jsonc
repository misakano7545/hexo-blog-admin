{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hexo-blog-admin",
	"compatibility_date": "2026-04-30",
	"main": "src/worker/index.ts",
	"keep_vars": true,
	// The panel is served through the admin.misakano.cn custom domain behind
	// Cloudflare Access. Without these two flags `wrangler deploy` silently
	// re-enables the public workers.dev/preview URLs, which bypass Access.
	"workers_dev": false,
	"preview_urls": false,
	// Route example:
	// "routes": [
	//   { "pattern": "admin.blog.plfjy.top/*", "zone_name": "plfjy.top" }
	// ],
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"kv_namespaces": [
		{
			"binding": "BLOG_ADMIN_KV"
			// Bind this name to your own KV namespace in Cloudflare.
		}
	],
	"d1_databases": [
		{
			"binding": "BLOG_ADMIN_DB"
			// Bind this name to your own D1 namespace in Cloudflare.
		}
	],
	// R2 is deliberately NOT declared here. Declaring an R2 binding without a
	// bucket name makes `wrangler deploy` try to auto-provision the bucket,
	// which fails with `code: 10042 Please enable R2` on any account without an
	// R2 subscription — so the whole deploy broke even though draft images can
	// fall back to BLOG_ADMIN_KV. Add BLOG_ASSET_CACHE manually as a Worker
	// binding in the Cloudflare dashboard if you do want R2.
	// "r2_buckets": [{ "binding": "BLOG_ASSET_CACHE" }]
}